{
  "globals": {
    "deltaT": 1,
    "deltaTUnit": "seconds",
    "startTime": "2019-01-01T06:00:00.000Z",
    "endTime": "2019-01-01T18:00:00.000Z",
    "output": "csv",
    "console" : false,
    "debug": true,
    "options": {
      "numberFormat": "G"
    },
    "knpCloseTimeHour": 18
  },
  "layers": [
    {
      "name": "VisitorTravelerLayer"
    },
    {
      "name": "SpatialGraphMediatorLayer",
      "inputs": [
        {
          "file": "resources/roads_all_2019_inferred2.geojson",
          "inputConfiguration": {
            "modalities": ["CarDriving"],
            "isBidirectedGraph": true
          }
        }
      ]
    },
    {
      "name": "POILayer",
      "file": "resources/pois_inferred.geojson"
    },
    {
      "name": "VisitorSchedulingLayer",
      "file": "resources/_emptyScheduler.csv"
    },
    {
      "name": "CommuterSchedulingLayer",
      "file": "resources/CommScheduler_debug_1.csv"
    },
    {
      "name": "ProducerSchedulingLayer",
      "file": "resources/ProducerScheduler.csv"
    }
  ],
  "entities": [
    {
      "name": "KnpCar",
      "file": "resources/car.csv"
    }
  ],
  "agents": [
    {
      "name": "EventProducer"
    },
    {
      "name": "Visitor",
      "outputs": [
        {
          "kind": "trips",
          "outputConfiguration": {
            "tripsFields": [
              "ActiveCapability"
            ]
          }
        },
        {
          "kind": "csv"
        }
      ]
    },
    {
      "name": "Commuter",
      "outputs": [
        {
          "kind": "trips",
          "outputConfiguration": {
            "tripsFields": [
              "ActiveCapability"
            ]
          }
        },
        {
          "kind": "csv"
        }
      ]
    }
  ] 
}
